<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gửi Người Ấy ✨</title>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #060919;
            overflow: hidden;
            height: 100vh;
            width: 100vw;
            font-family: 'Arial', sans-serif;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* 1. Màn hình nhập mật khẩu */
        #lock-screen {
            position: absolute;
            z-index: 100;
            background: rgba(10, 15, 30, 0.95);
            backdrop-filter: blur(15px);
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: #ffeaa7;
            text-align: center;
            padding: 20px;
            transition: all 0.8s ease;
        }
        .pass-box {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 234, 167, 0.3);
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 0 25px rgba(255, 234, 167, 0.2);
        }
        .pass-box h2 { font-size: 20px; margin-bottom: 15px; }
        .pass-input {
            padding: 12px 18px;
            border-radius: 25px;
            border: 2px solid #fdcb6e;
            background: transparent;
            color: #fff;
            font-size: 18px;
            text-align: center;
            outline: none;
            width: 200px;
            margin-bottom: 15px;
        }
        .btn-open {
            padding: 10px 25px;
            border-radius: 25px;
            border: none;
            background: linear-gradient(45deg, #ff7675, #fdcb6e);
            color: #fff;
            font-weight: bold;
            font-size: 16px;
            cursor: pointer;
            box-shadow: 0 0 15px rgba(255, 118, 117, 0.5);
        }

        /* 2. Giao diện thiệp ẩn phía sau */
        .moon {
            position: absolute;
            top: 40px;
            right: 40px;
            width: 90px;
            height: 90px;
            background: #ffeaa7;
            border-radius: 50%;
            box-shadow: 0 0 50px #ffeaa7, 0 0 100px #fdcb6e;
            z-index: 2;
        }
        .bg-text-container {
            position: absolute;
            top: -20%; left: -20%;
            width: 140%; height: 140%;
            transform: rotate(-15deg);
            display: flex;
            flex-direction: column;
            gap: 25px;
            opacity: 0.35;
            pointer-events: none;
            z-index: 1;
        }
        .text-row {
            white-space: nowrap;
            font-size: 22px;
            font-weight: bold;
            color: #74b9ff;
            text-shadow: 0 0 8px #0984e3;
            animation: moveText 20s linear infinite;
        }
        .text-row:nth-child(even) {
            color: #ff7675;
            text-shadow: 0 0 8px #d63031;
            animation-direction: reverse;
        }
        @keyframes moveText {
            0% { transform: translateX(0); }
            100% { transform: translateX(-30%); }
        }

        /* Sticker thả nổi */
        .sticker {
            position: absolute;
            z-index: 5;
            animation: float 4s ease-in-out infinite alternate;
            cursor: pointer;
        }
        @keyframes float {
            0% { transform: translateY(0px) rotate(0deg); }
            100% { transform: translateY(-12px) rotate(3deg); }
        }

        /* Thẻ chúc ở giữa */
        .main-card {
            position: absolute;
            z-index: 10;
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(12px);
            border: 2px solid rgba(255, 234, 167, 0.5);
            border-radius: 24px;
            padding: 25px 30px;
            text-align: center;
            box-shadow: 0 0 30px rgba(255, 234, 167, 0.3);
            max-width: 90%;
            width: 380px;
        }
        .main-card h2 { color: #ffeaa7; font-size: 22px; margin-bottom: 12px; }
        .main-card p { color: #ffffff; font-size: 15px; line-height: 1.6; }

        .music-btn {
            position: absolute;
            bottom: 30px; right: 30px;
            z-index: 20;
            background: rgba(255, 255, 255, 0.2);
            border: 1px solid #fff;
            color: #fff;
            border-radius: 50%;
            width: 45px; height: 45px;
            font-size: 20px;
            cursor: pointer;
        }
    </style>
</head>
<body>

    <!-- MÀN HÌNH MẬT KHẨU -->
    <div id="lock-screen">
        <div class="pass-box">
            <h2>🔒 Nhập mật khẩu để mở hộp quà Trung Thu</h2>
            <p style="font-size: 13px; color: #aaa; margin-bottom: 15px;">Mật Khẩu: Ngày sinh nhật của bạn</p>
            <input type="password" id="passInput" class="pass-input" placeholder="Mật khẩu...">
            <br>
            <button class="btn-open" onclick="checkPassword()">Mở Quà ✨</button>
            <p id="error-msg" style="color: #ff7675; font-size: 13px; margin-top: 10px; display: none;">Mật khẩu chưa đúng rồi nha! 😜</p>
        </div>
    </div>

    <!-- MẶT TRĂNG & NỀN MẪU -->
    <div class="moon"></div>
    <div class="bg-text-container">
        <div class="text-row">Chúc Cậu Trung Thu Vui Vẻ ✨ Trung thu vui vẻ 💖 Chúc Cậu Trung Thu Vui Vẻ ✨</div>
        <div class="text-row">Đêm Trăng Tròn Hạnh Phúc 🌕 Gia Đình Đoàn Viên 🏮 Đêm Trăng Tròn Hạnh Phúc 🌕</div>
        <div class="text-row">Chúc Cậu Trung Thu Vui Vẻ ✨ Trung thu vui vẻ 💖 Chúc Cậu Trung Thu Vui Vẻ ✨</div>
        <div class="text-row">Thập Cẩm 🥮 Đậu Xanh 🥮 Chúc Cậu Trung Thu Vui Vẻ ✨ Trung thu vui vẻ</div>
    </div>

    <!-- STICKER HỌA TIẾT -->
    <div class="sticker" style="top: 15%; left: 10%; font-size: 40px;" onclick="popHeart(event)">🐰</div>
    <div class="sticker" style="top: 25%; right: 25%; font-size: 35px;" onclick="popHeart(event)">🏮</div>
    <div class="sticker" style="bottom: 20%; left: 12%; font-size: 45px;" onclick="popHeart(event)">🥮</div>
    <div class="sticker" style="bottom: 15%; right: 15%; font-size: 38px;" onclick="popHeart(event)">💖</div>

    <!-- NỘI DUNG THIỆP CHÍNH -->
    <div class="main-card">
        <h2>✨ Trung Thu Vui Vẻ ✨</h2>
        <p>Trung<b> Thu </b> này ai cũng đòi đi rước đèn, còn tớ chỉ muốn 'rước' [Cậu] đi thôi. Chúc bạn có một đêm Trung thu ngọt ngào nhé!" ✉️</p>
        <p>Chúc <b> Cậu </b> một đêm Trung thu tràn ngập tiếng cười, nhận được thật nhiều quà và luôn rạng rỡ như ánh trăng nhé! ♥️</p>
      </div>

    <audio id="bg-music" loop src="https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf07a.mp3?filename=lofi-study-112191.mp3"></audio>
    <button class="music-btn" onclick="toggleMusic()">🎵</button>

    <script>
        // CÀI ĐẶT MẬT KHẨU TẠI ĐÂY (Thay '123456' bằng mật khẩu bạn muốn)
        const CORRECT_PASSWORD = "26112009"; 

        function checkPassword() {
            const input = document.getElementById("passInput").value;
            if (input === CORRECT_PASSWORD) {
                // Ẩn màn hình khóa
                document.getElementById("lock-screen").style.opacity = "0";
                setTimeout(() => {
                    document.getElementById("lock-screen").style.display = "none";
                }, 800);

                // Bật nhạc
                document.getElementById("bg-music").play();

                // Bắn pháo hoa ăn mừng khi mở đúng pass
                confetti({
                    particleCount: 100,
                    spread: 70,
                    origin: { y: 0.6 }
                });
            } else {
                document.getElementById("error-msg").style.display = "block";
            }
        }

        // Bấm vào các con thỏ/đèn lồng sẽ bắn pháo hoa nhỏ
        function popHeart(e) {
            confetti({
                particleCount: 30,
                spread: 50,
                origin: { x: e.clientX / window.innerWidth, y: e.clientY / window.innerHeight }
            });
        }

        function toggleMusic() {
            let music = document.getElementById("bg-music");
            if (music.paused) music.play();
            else music.pause();
        }
    </script>
</body>
</html
